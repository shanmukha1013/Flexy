# Copy this file to .env for local development. Never commit .env.
# Every variable below is read by config/env.js; nothing else is used.

# development | production | test
NODE_ENV=development
PORT=3001

# MongoDB connection string. If it contains the literal text ${MONGODB_PASSWORD},
# that placeholder is replaced with MONGODB_PASSWORD (URL-encoded).
# Required in production. Development default when unset: mongodb://127.0.0.1:27017/flexy
MONGODB_URI=
# MONGODB_PASSWORD=

# JWT signing secrets. Strongly recommended in production: at least 32 characters each,
# different from each other, and not a placeholder. If missing, short or a placeholder,
# production derives a stable secret from MONGODB_URI (and logs a warning) instead of
# refusing to start. In development a random per-process secret is used when unset.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# Sign-in uses usernames/emails and passwords; no email provider is needed.
# RESEND_API_KEY, EMAIL_FROM and EMAIL_TRANSPORT from the old email-code sign-in
# are ignored (startup names any that are still set, never their values).

# Comma-separated frontend origins allowed to call the API with credentials.
# Default: https://flexy-peach.vercel.app, plus http://localhost:3001 and
# http://127.0.0.1:3001 outside production.
# CORS_ORIGINS=

# Reverse-proxy hops in front of the app, so rate limiting sees real client IPs.
# Default: 1 in production (Render), disabled otherwise.
# TRUST_PROXY=
