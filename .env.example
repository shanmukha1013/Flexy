# Copy this file to .env for local development. Never commit .env.
# Every variable below is read by config/env.js; nothing else is used.

# development | production | test
NODE_ENV=development
PORT=3001

# MongoDB connection string. If it contains the literal text ${MONGODB_PASSWORD},
# that placeholder is replaced with MONGODB_PASSWORD (URL-encoded).
# Required in production. Development default when unset: mongodb://127.0.0.1:27017/flexy
MONGODB_URI=
# MONGODB_PASSWORD=

# JWT signing secrets. Required in production: at least 32 characters each, different
# from each other, and not a placeholder. In development a random per-process secret
# is used when unset (sessions then end when the server restarts).
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# Email delivery for OTP login.
#   resend  (default) sends through Resend and requires RESEND_API_KEY.
#   console prints codes to the server log so login can be tested locally without
#           an email account. Development only: the server refuses to start with it
#           in production.
EMAIL_TRANSPORT=resend
RESEND_API_KEY=
# Sender address. The default (Flexy <onboarding@resend.dev>) is Resend's shared test
# sender, which only delivers to the email address that owns the Resend account.
# To email other users, verify a domain in Resend and set, for example:
# EMAIL_FROM=Flexy <login@your-verified-domain.com>

# Comma-separated frontend origins allowed to call the API with credentials.
# Default: https://flexy-peach.vercel.app, plus http://localhost:3001 and
# http://127.0.0.1:3001 outside production.
# CORS_ORIGINS=

# Reverse-proxy hops in front of the app, so rate limiting sees real client IPs.
# Default: 1 in production (Render), disabled otherwise.
# TRUST_PROXY=
